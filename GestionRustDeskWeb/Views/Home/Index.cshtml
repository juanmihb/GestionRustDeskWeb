@model GestionRustDeskWeb.Models.RustDeskViewModel

@{
    ViewData["Title"] = "Gestión RustDesk Remoto";
}

<div class="container mt-4" style="max-width: 550px;">
    <h2 class="mb-4 text-center">Gestión Remota RustDesk</h2>

    @if (Model.Exito)
    {
        <div class="alert alert-success mt-3 shadow-sm">
            <h4 class="alert-heading">✅ Proceso completado</h4>
            <hr />
            <p class="mb-1"><strong>Equipo:</strong> @Model.Destino</p>
            <p class="mb-2"><strong>ID RustDesk:</strong> <span class="badge bg-primary fs-5">@Model.IdResultado</span></p>

            @if (Model.PassActualizada)
            {
                <p class="mb-0 text-success">🔑 Contraseña actualizada correctamente.</p>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger mt-3 shadow-sm">
            ❌ <strong>Error:</strong> @Model.MensajeError
        </div>
    }

    <form asp-action="Index" method="post" class="card card-body shadow-sm">
        <div class="mb-3">
            <label asp-for="Destino" class="form-label fw-bold"></label>
            <input asp-for="Destino" class="form-control" placeholder="Ej: 192.168.1.50 o sdig01" />
            <span asp-validation-for="Destino" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Usuario" class="form-label fw-bold"></label>
            <input asp-for="Usuario" class="form-control" placeholder="DOMINIO\usuario o sdig01\Administrador" />
            <span asp-validation-for="Usuario" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PasswordAdmin" class="form-label fw-bold"></label>
            <input asp-for="PasswordAdmin" class="form-control" />
            <span asp-validation-for="PasswordAdmin" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NuevaPassRustDesk" class="form-label fw-bold"></label>
            <input asp-for="NuevaPassRustDesk" class="form-control" placeholder="Opcional: Dejar en blanco si solo quieres ver la ID" />
            <span asp-validation-for="NuevaPassRustDesk" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">
            Ejecutar y Obtener ID
        </button>
    </form>
</div>